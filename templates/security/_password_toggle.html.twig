{#
    "Show" beside a password field, revealed by quire/show-password.js (loaded once by the page):
    without JavaScript it stays hidden, and the field a plain password field. It says what it does next,
    "Show" or "Hide", and its name always holds the word it shows (WCAG 2.5.3), so it has no pressed
    state, which would say it twice. Variables: field, the password input's id.
#}
<button type="button" class="password-toggle" data-quire-password-toggle aria-controls="{{ field }}" aria-label="{{ 'Show password'|trans({}, 'quire') }}"
    data-show="{{ 'Show'|trans({}, 'quire') }}" data-show-label="{{ 'Show password'|trans({}, 'quire') }}" data-hide="{{ 'Hide'|trans({}, 'quire') }}" data-hide-label="{{ 'Hide password'|trans({}, 'quire') }}" hidden>{{ 'Show'|trans({}, 'quire') }}</button>
{#- What happened, said once: some screen readers don't read a button's name again when it changes under focus -#}
<span class="visually-hidden" role="status" data-quire-password-status data-shown="{{ 'Your password is visible.'|trans({}, 'quire') }}" data-hidden="{{ 'Your password is hidden.'|trans({}, 'quire') }}"></span>
