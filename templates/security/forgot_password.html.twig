{#
    Asks for the email to send a password reset link to, when "quire.auth.password_reset" is on.

    Variables: email (what was typed), errors (form: why the form wasn't accepted)
    Blocks: account (everything on the page, its script included: a theme wraps it, e.g. in a card), and in it
    account_heading (the heading and its intro).
#}
{% extends 'layout.html.twig' %}

{% block title %}{{ 'Forgot your password?'|trans({}, 'quire') }} – {{ site.title }}{% endblock %}

{% block content %}
    <section class="sign-in account">
        {% block account %}
            {% block account_heading %}
                <h1>{{ 'Forgot your password?'|quire_trans({}, 'quire') }}</h1>
                <p class="account-intro">{{ 'Enter your email address, and we’ll send you a link to choose a new password.'|quire_trans({}, 'quire') }}</p>
            {% endblock %}

            {% if errors.form is defined %}
                <p class="form-error" role="alert"><span>{{ errors.form|quire_trans({}, 'quire') }}</span></p>
            {% endif %}

            <form method="post" action="{{ path('quire_forgot_password') }}" class="form">
                <p class="form-field">
                    <label for="email">{{ 'Email'|quire_trans({}, 'quire') }}</label>
                    <input type="email" id="email" name="email" value="{{ email }}" autocomplete="email" required>
                </p>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                <p><button type="submit">{{ 'Send the link'|quire_trans({}, 'quire') }}</button></p>
            </form>

            <div class="account-links"><p><a href="{{ path('quire_login') }}">{{ 'Back to signing in'|quire_trans({}, 'quire') }}</a></p></div>
        {% endblock %}
    </section>
{% endblock %}
