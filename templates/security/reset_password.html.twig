{#
    Choosing a new password, after opening the emailed link, or a first one when invited.

    Variables: user (whose password it is), errors (password, form), route (where the form goes),
    invitation (whether it's their first)
    Variables: role (an invitation's: the label of the role it gives, or null)
    Blocks: account (everything on the page, its script included: a theme wraps it, e.g. in a card), and in it
    account_heading (the heading and its intro).
#}
{% extends 'layout.html.twig' %}

{% set heading = (invitation ?? false) ? 'Choose your password' : 'Choose a new password' %}

{% block title %}{{ heading|trans({}, 'quire') }} – {{ site.title }}{% endblock %}

{% block content %}
    <section class="sign-in account">
        {% block account %}
            {% block account_heading %}
                {% if invitation ?? false %}
                    <h1>{{ 'Welcome, {name}'|quire_trans({name: user.displayName}, 'quire') }}</h1>
                    <p class="account-intro">{{ (role ?? null ? 'You’ve been invited to {site} as {role}. Choose the password you’ll sign in with as {username}.' : 'You’ve been invited to {site}. Choose the password you’ll sign in with as {username}.')|quire_trans_html({site: site.title, role: _self.strong(role ?? ''), username: _self.chip(user.username)}, 'quire') }}</p>
                    <p class="form-hint">{{ 'Not expecting this invitation? Leave this page. Nothing happens until you choose a password.'|quire_trans({}, 'quire') }}</p>
                {% else %}
                    <h1>{{ heading|quire_trans({}, 'quire') }}</h1>
                    <p class="account-intro">{{ 'You’ll sign in with it as {username}.'|quire_trans_html({username: _self.chip(user.username)}, 'quire') }}</p>
                {% endif %}
            {% endblock %}

            {% if errors.form is defined %}
                <p class="form-error" role="alert"><span>{{ errors.form|quire_trans({}, 'quire') }}</span></p>
            {% endif %}

            <form method="post" action="{{ path(route ?? 'quire_reset_password') }}" class="form" novalidate>
                {# Lets password managers save the new password for the right account. #}
                <input type="hidden" name="username" value="{{ user.email }}" autocomplete="username">
                <p class="form-field">
                    <label for="password">{{ ((invitation ?? false) ? 'Password' : 'New password')|quire_trans({}, 'quire') }}</label>
                    <span class="form-password"><input type="password" id="password" spellcheck="false" autocapitalize="none" autocorrect="off" name="password" autocomplete="new-password" minlength="8" required aria-describedby="password-hint{% if errors.password is defined %} password-error{% endif %}"{% if errors.password is defined %} aria-invalid="true"{% endif %}>{{ include('security/_password_toggle.html.twig', {field: 'password'}) }}</span>
                    <span class="form-hint" id="password-hint">{{ 'At least 8 characters.'|quire_trans({}, 'quire') }}</span>
                    {% if errors.password is defined %}<span class="form-error" id="password-error">{{ errors.password|quire_trans({}, 'quire') }}</span>{% endif %}
                </p>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
                <p><button type="submit">{{ ((invitation ?? false) ? 'Choose password' : 'Change password')|quire_trans({}, 'quire') }}</button></p>
            </form>
            <script type="module" src="{{ asset('quire/show-password.js') }}"></script>
        {% endblock %}
    </section>
{% endblock %}

{# The username, as HTML the translated message holds #}
{% macro chip(username) %}<span class="email">{{ username }}</span>{% endmacro %}
{% macro strong(text) %}<strong>{{ text }}</strong>{% endmacro %}
