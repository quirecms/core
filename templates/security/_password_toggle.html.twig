{#
    "Show" beside a password field, revealed by quire/show-password.js (loaded once by the page):
    without JavaScript it stays hidden, and the field a plain password field. Variables: field, the
    password input's id.
#}
<button type="button" class="password-toggle" data-quire-password-toggle aria-controls="{{ field }}" aria-pressed="false" aria-label="{{ 'Show password'|trans({}, 'quire') }}" hidden>{{ 'Show'|trans({}, 'quire') }}</button>
