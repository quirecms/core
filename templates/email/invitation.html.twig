{# Variables: user, url (the link to choose a password), invited_by (the admin who invited them, or null), role (the role they're invited as, by name, or null) #}
{% extends 'email/layout.html.twig' %}

{% block body %}
    <p>{{ 'Hello {name},'|trans({ name: user.displayName }, 'quire') }}</p>
    <p>
        {{ (invited_by ? (role ? '{admin} invited you to {site} as {role}. Your username is {username}. Choose your password to sign in:' : '{admin} invited you to {site}. Your username is {username}. Choose your password to sign in:') : (role ? 'You’re invited to {site} as {role}. Your username is {username}. Choose your password to sign in:' : 'You’re invited to {site}. Your username is {username}. Choose your password to sign in:'))|trans({ admin: invited_by.displayName ?? '', site: site.title, role: role ?? '', username: user.username }, 'quire') }}
    </p>
    <p><a href="{{ url }}" style="display: inline-block; padding: 10px 18px; background: #1c184b; color: #ffffff; border-radius: 6px; text-decoration: none;">{{ 'Choose your password'|trans({}, 'quire') }}</a></p>
    <p>{{ 'The link works once, for seven days.'|trans({}, 'quire') }}</p>
{% endblock %}
